#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${BASE_URL:-http://127.0.0.1:30004}"
LOG_FILE="${LOG_FILE:-/mnt/data/shm/sglang-fusionrag-fusionrag_unified_pipeline/sg_e2e_30004.log}"
MODEL_PATH="${MODEL_PATH:-/mnt/data/models/Qwen2.5-0.5B-Instruct}"
TMP_DIR="${TMP_DIR:-/tmp/fusionrag_curl_check}"
mkdir -p "$TMP_DIR"

say(){ echo; echo "== $* =="; }
fail(){ echo "FAIL: $*" >&2; exit 1; }

extract_json_field() {
  local file="$1"; local field="$2"
  python3 - "$file" "$field" <<'PY'
import json,sys
f,field=sys.argv[1],sys.argv[2]
obj=json.load(open(f))
val=obj
for p in field.split('.'):
    val=val[p]
while isinstance(val,list) and len(val)==1:
    val=val[0]
print(val)
PY
}

say "Health"
curl -sS "$BASE_URL/model_info" >/dev/null || fail "service not ready: $BASE_URL"

TEXT="prefixZ::Document A says Paris is in France. tail tokens for generation"
DOC="Document A says Paris is in France."

DOC_TOKENS=$(python3 - <<PY
from transformers import AutoTokenizer
t=AutoTokenizer.from_pretrained('$MODEL_PATH', trust_remote_code=True)
print(len(t.encode('$DOC', add_special_tokens=False)))
PY
)
P=$(python3 - <<PY
from transformers import AutoTokenizer
t=AutoTokenizer.from_pretrained('$MODEL_PATH', trust_remote_code=True)
print(len(t.encode('prefixZ::', add_special_tokens=False)))
PY
)
E=$((P+DOC_TOKENS))

say "0) Build Request JSON (human-readable)"
cat > "$TMP_DIR/no_fusion.json" <<JSON
{
  "text": "$TEXT",
  "sampling_params": {
    "temperature": 0,
    "max_new_tokens": 64
  }
}
JSON

cat > "$TMP_DIR/kv_gen_raw.json" <<JSON
{
  "text": "$DOC",
  "sampling_params": {
    "temperature": 0,
    "max_new_tokens": 0
  },
  "fusionrag_params": {
    "enable": true,
    "mode": "kv_gen",
    "cache_policy": {
      "use_radix_cache": false,
      "use_chunk_cache": false,
      "save_to_radix_cache": false,
      "save_to_chunk_cache": true
    },
    "chunk_plan": [
      {
        "doc_id": "doc_demo",
        "chunk_id": "doc_demo_c0",
        "doc_text": "$DOC",
        "cache_variant": "raw",
        "start_token": 0,
        "end_token": $DOC_TOKENS,
        "use_preprocess_cache": false,
        "recompute_token_idx_local": []
      }
    ],
    "kv_gen": {
      "target_doc_id": "doc_demo",
      "target_chunk_id": "doc_demo_c0",
      "save_variants": ["raw"],
      "strip_prefix": false
    }
  }
}
JSON

cat > "$TMP_DIR/fusion_empty.json" <<JSON
{
  "text": "$TEXT",
  "sampling_params": {
    "temperature": 0,
    "max_new_tokens": 64
  },
  "fusionrag_params": {
    "enable": true,
    "mode": "generate",
    "cache_policy": {
      "use_radix_cache": true,
      "use_chunk_cache": false,
      "save_to_radix_cache": true,
      "save_to_chunk_cache": false
    },
    "chunk_plan": [],
    "recompute_token_idx": []
  }
}
JSON

cat > "$TMP_DIR/fusion_chunk.json" <<JSON
{
  "text": "$TEXT",
  "sampling_params": {
    "temperature": 0,
    "max_new_tokens": 64
  },
  "fusionrag_params": {
    "enable": true,
    "mode": "generate",
    "cache_policy": {
      "use_radix_cache": true,
      "use_chunk_cache": true,
      "save_to_radix_cache": true,
      "save_to_chunk_cache": false
    },
    "chunk_plan": [
      {
        "doc_id": "doc_demo",
        "chunk_id": "doc_demo_c0",
        "doc_text": "$DOC",
        "cache_variant": "raw",
        "start_token": $P,
        "end_token": $E,
        "use_preprocess_cache": false,
        "recompute_token_idx_local": [0, 2]
      }
    ],
    "recompute_token_idx": [$P, $((P+1))]
  }
}
JSON

for f in no_fusion.json kv_gen_raw.json fusion_empty.json fusion_chunk.json; do
  echo "----- $TMP_DIR/$f -----"
  cat "$TMP_DIR/$f"
done

say "1) no-fusion baseline"
curl -sS "$BASE_URL/generate" -H 'content-type: application/json' -d @"$TMP_DIR/no_fusion.json" > "$TMP_DIR/no_fusion.resp.json"
python3 - <<PY
import json
r=json.load(open('$TMP_DIR/no_fusion.resp.json'))
print(r.get('text','')[:400])
PY

say "2) kv_gen raw save"
curl -sS "$BASE_URL/generate" -H 'content-type: application/json' -d @"$TMP_DIR/kv_gen_raw.json" > "$TMP_DIR/kv_gen_raw.resp.json"
python3 - <<PY
import json
r=json.load(open('$TMP_DIR/kv_gen_raw.resp.json'))
print('id=', r.get('meta_info',{}).get('id'))
print('prompt_tokens=', r.get('meta_info',{}).get('prompt_tokens'))
PY

say "3) fusion-empty (same prompt path, no chunk)"
curl -sS "$BASE_URL/generate" -H 'content-type: application/json' -d @"$TMP_DIR/fusion_empty.json" > "$TMP_DIR/fusion_empty.resp.json"
python3 - <<PY
import json
r=json.load(open('$TMP_DIR/fusion_empty.resp.json'))
print(r.get('text','')[:400])
mi=r.get('meta_info',{})
for k in ['fusionrag_chunk_lookup_hits','fusionrag_chunk_lookup_misses','fusionrag_recompute_tokens','fusionrag_fallback_reason']:
    print(k, mi.get(k))
PY

say "4) fusion-chunk + recompute"
curl -sS "$BASE_URL/generate" -H 'content-type: application/json' -d @"$TMP_DIR/fusion_chunk.json" > "$TMP_DIR/fusion_chunk.resp.json"
python3 - <<PY
import json,sys
r=json.load(open('$TMP_DIR/fusion_chunk.resp.json'))
print(r.get('text','')[:400])
mi=r.get('meta_info',{})
for k in ['fusionrag_chunk_hit_tokens','fusionrag_recompute_tokens','fusionrag_compute_tokens','fusionrag_prefill_tokens','fusionrag_chunk_lookup_hits','fusionrag_chunk_lookup_misses','fusionrag_fallback_reason']:
    print(k, mi.get(k))
hits=mi.get('fusionrag_chunk_lookup_hits',[0])
if isinstance(hits,list): hits=hits[0] if hits else 0
if int(hits) < 1:
    print('FAIL: expected chunk hit >=1, got', hits)
    sys.exit(2)
print('PASS: chunk hit >=1')
PY

say "5) readability verdict"
python3 - <<PY
import json
nf=json.load(open('$TMP_DIR/no_fusion.resp.json')).get('text','')
fe=json.load(open('$TMP_DIR/fusion_empty.resp.json')).get('text','')
fc=json.load(open('$TMP_DIR/fusion_chunk.resp.json')).get('text','')
for name,txt in [('no_fusion',nf),('fusion_empty',fe),('fusion_chunk',fc)]:
    bad = txt.count('prefixZ::Document') + txt.count('::')
    print(name, 'len=',len(txt), 'marker_repeat_score=',bad)
print('Interpretation: if no_fusion and fusion_empty are already bad, issue is generation path/prompt format; if only fusion_chunk bad, issue is fusion execution path.')
PY

say "6) key logs"
rg -n "\[FusionRAG\] req_summary|\[FusionRAG\] cache_save|\[FusionRAG\] chunk_plan_partial_miss|fusionrag_prefill_compute|recompute_idx_oob" "$LOG_FILE" | tail -n 160 || true

say "done"
